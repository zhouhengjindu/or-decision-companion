{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "or-decision-companion",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "or-decision-companion",
      "database_id": "5a7cbcb7-2647-482a-9f29-ffdea41e339f",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "staging": {
      "name": "or-decision-companion-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "or-decision-companion-staging",
          "database_id": "715ca2b9-0c37-4fca-b8de-ab26cf885712",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
